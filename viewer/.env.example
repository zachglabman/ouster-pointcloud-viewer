# Copy to viewer/.env and fill in (all optional). Read at build time by vite.config.js; not committed.
# Public URL of the deployed viewer folder, used for link previews (og:url, og:image):
VITE_SITE_URL=https://storage.googleapis.com/my-pointcloud-viewer/viewer
# Google Analytics 4 measurement ID and/or Google Tag Manager container (production builds only):
VITE_GA4_ID=
VITE_GTM_ID=
